  "Game loop": {
    "prefix": "gameloop",
    "body": [
      "import { } from \"game\";",
      "",
      "enableFrameStrings();",
      "openWindow(${1:800}, ${2:600}, \"${3:my game}\");",
      "setTargetFps(60);",
      "",
      "while (!windowShouldClose()) {",
      "\tlet dt: f64 = deltaTime();",
      "",
      "\tbeginFrame();",
      "\tclearScreen(rgb(20, 20, 30));",
      "\t$0",
      "\tendFrame();",
      "}",
      "",
      "closeWindow();"
    ],
    "description": "A complete game loop"
  },
  "Poolable entity class": {
    "prefix": "entity",
    "body": [
      "class ${1:Entity} {",
      "\tx: f64 = 0.0;",
      "\ty: f64 = 0.0;",
      "\tactive: boolean = false;",
      "",
      "\tspawn(x: f64, y: f64): void {",
      "\t\tthis.x = x;",
      "\t\tthis.y = y;",
      "\t\tthis.active = true;",
      "\t}",
      "",
      "\tstep(dt: f64): void {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "An entity class shaped for pooling"
  },
  "Entity pool": {
    "prefix": "pool",
    "body": [
      "let ${1:entities}: ${2:Entity}[] = [];",
      "let ${3:i}: i32 = 0;",
      "while (${3:i} < ${4:MAX_${2/(.*)/${1:/upcase}/}}) { ${1:entities}.push(new ${2:Entity}()); ${3:i} += 1; }",
      "",
      "function take${2:Entity}(pool: ${2:Entity}[]): ${2:Entity} {",
      "\tlet i: i32 = 0;",
      "\twhile (i < pool.length) {",
      "\t\tlet candidate: ${2:Entity} = pool[i];",
      "\t\tif (!candidate.active) { return candidate; }",
      "\t\ti += 1;",
      "\t}",
      "\treturn null;",
      "}"
    ],
    "description": "Preallocated entity pool with a claim helper"
  }
}
